# AI Interview Assessment & Evidence System — Environment Configuration
# Copy this file to .env and insert your personal API key.
# This file serves as a template and contains no secrets.

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Code Execution Sandbox (optional, defaults to Wandbox compiler API)
SANDBOX_URL=https://wandbox.org/api/compile.json
